# Copy to .env.local and fill in. Never commit .env.local.

# Meta Model API: key from the dashboard (https://dev.meta.ai/) under "API keys".
# Format: LLM|<numeric_id>|<secret>
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# ElevenLabs (optional): the description voice (pnpm render-cue-audio) and the
# narrated demo clips (pnpm build-demo-clip).
ELEVENLABS_API_KEY=
# Voice for the demo clips' presenter. Default: George (JBFqnCBsd6RMkjVDRZzb).
ELEVENLABS_VOICE_ID=
# Voice for the descriptions. Default: Alice (Xb7hH8MSUJpSbSDYk0k2).
# ELEVENLABS_DESCRIBER_VOICE_ID=

# Build-time switch for the deployed demo: reviews are kept in the browser,
# not saved on the server. scripts/deploy.sh sets it; leave unset locally.
# NAME_IT_DEMO_MODE=1

# Where pnpm check-web and pnpm screenshots look for the app. Default: http://localhost:3123
# BASE_URL=
