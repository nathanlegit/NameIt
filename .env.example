# Copy to .env.local and fill in. Never commit .env.local.
# Key from the Model API dashboard (https://dev.meta.ai/) under "API keys".
# Format: LLM|<numeric_id>|<secret>
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Optional: only needed to build narrated demo clips (pnpm build-clip).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
